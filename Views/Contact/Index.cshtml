@model ContactViewModel
@{
    ViewData["Title"] = "Contact us";
    ViewData["Nav"] = "Contact";
}
@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
}

<section class="contact">
    <div class="container contact-inner">
        <h1 class="title center">Contact us</h1>
        <p class="contact-lead">We love hearing from our customers. Feel free to share your experience or ask any questions you may have.</p>

        @if (TempData["ContactSent"] is string name)
        {
            <p class="contact-sent">Thank you, @name! Your message has been sent. We'll get back to you soon.</p>
        }

        <form asp-action="Index" method="post" novalidate class="contact-form">
            <label class="co-field"><span class="sr-only">First name</span><input asp-for="FirstName" placeholder="First name" autocomplete="given-name" /><span asp-validation-for="FirstName" class="field-error"></span></label>
            <label class="co-field"><span class="sr-only">Last name</span><input asp-for="LastName" placeholder="Last name" autocomplete="family-name" /></label>
            <label class="co-field"><span class="sr-only">Email address</span><input asp-for="Email" type="email" placeholder="Email address" autocomplete="email" /><span asp-validation-for="Email" class="field-error"></span></label>
            <label class="co-field"><span class="sr-only">Subject</span><input asp-for="Subject" placeholder="Subject" /></label>
            <label class="co-field co-wide"><span class="sr-only">Message</span><textarea asp-for="Message" rows="6" placeholder="Message"></textarea><span asp-validation-for="Message" class="field-error"></span></label>
            <button class="booking-submit contact-submit" type="submit">Submit</button>
        </form>
    </div>

    <div class="contact-map-wrap">
        <div class="contact-map" id="contact-map"></div>
        <div class="contact-card" data-contact-card>
            <button type="button" class="contact-card-close" data-contact-close aria-label="Hide"><partial name="_Icons" model='"x"' /></button>
            <img src="~/img/reserve-small1.png" alt="" />
            <div>
                <h2>Delizioso Restaurant</h2>
                <p>3247 Johnson Ave, Bronx, NY 10463, Amerika Serikat</p>
                <p>40.885147, -73.9220459</p>
            </div>
            <a class="contact-go" href="https://www.google.com/maps/dir/?api=1&destination=40.885147,-73.9220459" target="_blank" rel="noopener" aria-label="Get directions"><partial name="_Icons" model='"send"' /></a>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
    <script>
        (function () {
            const spot = [40.885147, -73.9220459];
            const map = L.map('contact-map', { scrollWheelZoom: false }).setView([spot[0] + 0.004, spot[1]], 14);
            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19, attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
            }).addTo(map);
            L.marker(spot, { icon: L.divIcon({
                className: 'map-pin', iconSize: [52, 66], iconAnchor: [26, 66],
                html: '<svg width="52" height="66" viewBox="0 0 44 56"><path d="M22 0C10 0 0 9.6 0 21.6 0 37.8 22 56 22 56s22-18.2 22-34.4C44 9.6 34 0 22 0z" fill="#f65a5a"/><circle cx="22" cy="21" r="9" fill="#fff"/></svg>' }) }).addTo(map);
            const card = document.querySelector('[data-contact-card]');
            document.querySelector('[data-contact-close]').addEventListener('click', () => card.hidden = true);
        })();
    </script>
}
