@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "_AuthLayout";
}

<h1>Forgot password</h1>
<p class="auth-switch">Remembered it? <a asp-action="Login">Log in</a></p>

@if (TempData["Notice"] is string notice)
{
    <p class="auth-notice">@notice</p>
}

@if (ViewData["Sent"] is string sent)
{
    <p class="auth-notice">If an account exists for <b>@sent</b>, we've sent a link to reset the password. It is valid for 2 hours.</p>
    <partial name="_DevLink" />
}
else
{
    <form asp-action="ForgotPassword" method="post" novalidate>
        <label class="field">
            <span>Email address</span>
            <input asp-for="Email" type="email" placeholder="Robertmartine@gmail.com" autocomplete="email" />
            <span asp-validation-for="Email" class="field-error"></span>
        </label>
        <button class="auth-submit" type="submit">Send reset link</button>
    </form>
}
