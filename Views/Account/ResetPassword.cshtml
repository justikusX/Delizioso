@model ResetPasswordViewModel
@{
    ViewData["Title"] = "New password";
    Layout = "_AuthLayout";
}

<h1>New password</h1>
<p class="auth-switch">Choose a new password for your account.</p>

<form asp-action="ResetPassword" method="post" novalidate>
    <input type="hidden" asp-for="Token" />
    <label class="field">
        <span>New password</span>
        <input asp-for="Password" placeholder="At least 6 characters" autocomplete="new-password" />
        <span asp-validation-for="Password" class="field-error"></span>
    </label>
    <label class="field">
        <span>Repeat password</span>
        <input asp-for="ConfirmPassword" placeholder="Repeat the new password" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
    </label>
    <button class="auth-submit" type="submit">Save password</button>
</form>
