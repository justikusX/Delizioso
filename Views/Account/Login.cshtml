@model LoginViewModel
@{
    ViewData["Title"] = "Log in";
    ViewData["ReturnUrl"] = Model.ReturnUrl;
    Layout = "_AuthLayout";
}

<h1>Login</h1>
<p class="auth-switch">Don't have an account? <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">Sign up</a></p>

@if (TempData["Notice"] is string notice)
{
    <p class="auth-notice">@notice</p>
}

<form asp-action="Login" method="post" novalidate>
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="auth-error"></div>

    <label class="field">
        <span>Email address</span>
        <input asp-for="Email" type="email" placeholder="Robertmartine@gmail.com" autocomplete="email" />
        <span asp-validation-for="Email" class="field-error"></span>
    </label>

    <label class="field">
        <span>Password</span>
        <input asp-for="Password" placeholder="Your password" autocomplete="current-password" />
        <span asp-validation-for="Password" class="field-error"></span>
    </label>

    <div class="auth-row">
        <label class="check"><input asp-for="RememberMe" type="checkbox" /> <span>Remember me</span></label>
        <a asp-action="ForgotPassword">Forget Password?</a>
    </div>

    <button class="auth-submit" type="submit">Log in</button>
</form>

@if (ViewData["Unconfirmed"] is string unconfirmed)
{
    <form asp-action="ResendConfirmation" method="post" class="auth-resend">
        <input type="hidden" name="email" value="@unconfirmed" />
        <button type="submit">Send the confirmation link again</button>
    </form>
}

<partial name="_GoogleButton" model="@("Log in with google")" />
