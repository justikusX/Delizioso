@model MyAccountViewModel
@{
    ViewData["Title"] = "My account";
    var culture = System.Globalization.CultureInfo.InvariantCulture;
    string Money(decimal d) => "$" + d.ToString("0.00", culture);
    var upcoming = Model.Reservations.Where(r => r.Status != "Cancelled" && r.ReservedFor >= DateTime.Now).OrderBy(r => r.ReservedFor).ToList();
    var past = Model.Reservations.Except(upcoming).ToList();
}

<section class="account">
    <div class="container">
        <h1 class="title center">My account</h1>

        @if (TempData["AccountNotice"] is string notice)
        {
            <p class="contact-sent">@notice</p>
        }

        <div class="account-grid">
            <aside class="account-side">
                <div class="res-card account-card">
                    <div class="account-avatar">@(Model.User.FullName.Length > 0 ? Model.User.FullName[..1].ToUpperInvariant() : "?")</div>
                    <h2>@Model.User.FullName</h2>
                    <p class="account-email">@Model.User.Email</p>
                    <p class="account-badge">@(Model.User.GoogleId != null ? "Signed in with Google" : "Email account") &middot; since @Model.User.CreatedAt.ToLocalTime().ToString("MMM yyyy", culture)</p>

                    <form asp-action="Profile" method="post" novalidate class="account-form">
                        <label class="field">
                            <span>Full name</span>
                            <input asp-for="Profile.FullName" autocomplete="name" />
                            <span asp-validation-for="Profile.FullName" class="field-error"></span>
                        </label>
                        <div class="field">
                            <span>Phone</span>
                            <div class="account-phone">
                                <select asp-for="Profile.PhoneCode" aria-label="Country code">
                                    @foreach (var p in FormOptions.PhoneCodes) { <option value="@p.Code">@p.Country @p.Code</option> }
                                </select>
                                <input asp-for="Profile.Phone" type="tel" placeholder="Phone number" autocomplete="tel-national" aria-label="Phone number" />
                            </div>
                            <span asp-validation-for="Profile.Phone" class="field-error"></span>
                        </div>
                        <button class="auth-submit" type="submit">Save profile</button>
                    </form>
                    @if (Model.User.PasswordHash == "")
                    {
                        <p class="co-hint">You sign in with Google. <a asp-action="ForgotPassword">Set a password</a> to also log in by email.</p>
                    }
                </div>

                <div class="res-card account-card" id="addresses">
                    <h2 class="res-h">Saved addresses</h2>
                    @if (Model.Addresses.Count == 0)
                    {
                        <p class="account-empty">Addresses from your delivery orders will appear here.</p>
                    }
                    <ul class="account-addresses">
                        @foreach (var a in Model.Addresses)
                        {
                            <li>
                                <span>@a.Text</span>
                                <form asp-action="DeleteAddress" asp-route-id="@a.Id" method="post">
                                    <button type="submit" class="order-remove" aria-label="Delete address"><partial name="_Icons" model='"trash"' /></button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </aside>

            <div class="account-main">
                <h2 class="co-h">My orders</h2>
                @if (Model.Orders.Count == 0)
                {
                    <p class="account-empty">No orders yet. <a asp-controller="Order" asp-action="Index">Order something tasty</a>.</p>
                }
                @foreach (var o in Model.Orders)
                {
                    <article class="account-order">
                        <header>
                            <div>
                                <b>#@o.Code</b>
                                <span>@o.CreatedAt.ToLocalTime().ToString("d MMM yyyy, h:mm tt", culture)</span>
                            </div>
                            <span class="account-status">@o.Status</span>
                        </header>
                        <p class="account-items">@string.Join(", ", o.Items.Select(i => $"{i.Dish?.Name} × {i.Quantity}"))</p>
                        <p class="account-where">@(o.Method == "Delivery" ? "Delivery to " + o.Address : "Take away")</p>
                        <footer>
                            <b>@Money(o.Total)</b>
                            <a asp-controller="Order" asp-action="Placed" asp-route-code="@o.Code">Details</a>
                        </footer>
                    </article>
                }

                <h2 class="co-h account-h">My reservations</h2>
                @if (Model.Reservations.Count == 0)
                {
                    <p class="account-empty">No reservations yet. <a asp-controller="Reservation" asp-action="Index">Book a table</a>.</p>
                }
                @foreach (var r in upcoming.Concat(past))
                {
                    <article class="account-order @(upcoming.Contains(r) ? "" : "past")">
                        <header>
                            <div>
                                <b>#@r.Code</b>
                                <span>@r.ReservedFor.ToString("dddd, d MMM yyyy 'at' h:mm tt", culture)</span>
                            </div>
                            <span class="account-status">@(upcoming.Contains(r) ? "Upcoming" : r.Status == "Cancelled" ? "Cancelled" : "Past")</span>
                        </header>
                        <p class="account-items">@r.Guests @(r.Guests == 1 ? "person" : "people")@(r.Occasion != "" ? " · " + r.Occasion : "")</p>
                        <footer>
                            <span></span>
                            <a asp-controller="Reservation" asp-action="Details" asp-route-code="@r.Code">@(upcoming.Contains(r) ? "Change or cancel" : "Details")</a>
                        </footer>
                    </article>
                }
            </div>
        </div>
    </div>
</section>
