@{
    ViewData["Title"] = "Check your email";
    Layout = "_AuthLayout";
    var email = ViewData["Email"] as string ?? "";
}

<h1>Check your email</h1>
<p class="auth-switch">We sent a confirmation link to <b>@email</b>. Open it to finish creating your account.</p>
<p class="auth-text">Didn't get it? Check the spam folder, or send the link again. The link is valid for 3 days.</p>

<partial name="_DevLink" />

<form asp-action="ResendConfirmation" method="post">
    <input type="hidden" name="email" value="@email" />
    <button class="auth-google" type="submit">Send the link again</button>
</form>
<p class="auth-switch auth-bottom"><a asp-action="Login">Back to log in</a></p>
