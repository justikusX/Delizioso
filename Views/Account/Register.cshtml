@model RegisterViewModel
@{
    ViewData["Title"] = "Sign up";
    ViewData["ReturnUrl"] = Model.ReturnUrl;
    Layout = "_AuthLayout";
}

<h1>Sign up</h1>
<p class="auth-switch">Already have an account? <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a></p>

<form asp-action="Register" method="post" novalidate>
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="auth-error"></div>

    <label class="field">
        <span>Full name</span>
        <input asp-for="FullName" placeholder="Robert Martine" autocomplete="name" />
        <span asp-validation-for="FullName" class="field-error"></span>
    </label>

    <label class="field">
        <span>Email address</span>
        <input asp-for="Email" type="email" placeholder="Robertmartine@gmail.com" autocomplete="email" />
        <span asp-validation-for="Email" class="field-error"></span>
    </label>

    <label class="field">
        <span>Password</span>
        <input asp-for="Password" placeholder="At least 6 characters" autocomplete="new-password" />
        <span asp-validation-for="Password" class="field-error"></span>
    </label>

    <div class="auth-row">
        <label class="check"><input asp-for="RememberMe" type="checkbox" /> <span>Remember me</span></label>
        <a asp-action="ForgotPassword">Forget Password?</a>
    </div>

    <button class="auth-submit" type="submit">Sign up</button>
</form>

<partial name="_GoogleButton" model="@("Sign up with google")" />
