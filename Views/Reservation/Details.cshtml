@model Reservation
@{
    var cancelled = Model.Status == "Cancelled";
    ViewData["Title"] = cancelled ? "Reservation cancelled" : "Reservation confirmed";
    ViewData["Nav"] = "Reservation";
    ViewData["BodyClass"] = "modal-page";
}

<section class="modal-stage">
    <partial name="_ModalStage" model='"/Reservation"' />
    <div class="modal-card">
        <partial name="_ModalTop" />

        <div class="status-banner @(cancelled ? "grey" : "green")">
            <span class="bubble b1"></span><span class="bubble b2"></span><span class="bubble b3"></span><span class="bubble b4"></span>
            <h1>@(cancelled ? "Reservation has been cancelled" : "Reservation has been confirmed")</h1>
            @if (!cancelled)
            {
                <p><partial name="_Icons" model='"check"' /> Keep this page or your booking ID to change or cancel the reservation</p>
            }
            <p><partial name="_Icons" model='"ticket"' /> Booking ID : #@Model.Code</p>
        </div>

        <div class="res-summary">
            <div class="ring-photo"><img src="~/img/about-table.png" alt="" /></div>
            <div class="res-summary-detail @(cancelled ? "muted" : "")">
                <h2 class="res-h">Reservation detail</h2>
                <partial name="_Detail" model="(Model.ReservedFor, Model.Guests)" />
            </div>
            <div class="res-actions">
                @if (cancelled)
                {
                    <a class="res-action modify" asp-action="Index">Book again</a>
                }
                else
                {
                    <a class="res-action modify" asp-action="Index" asp-route-modify="@Model.Code">Modify <partial name="_Icons" model='"edit"' /></a>
                    <a class="res-action cancel" asp-action="Cancel" asp-route-code="@Model.Code">Cancel <partial name="_Icons" model='"x"' /></a>
                }
            </div>
        </div>

        <div class="res-extra">
            @if (!cancelled)
            {
                <form class="res-notes" asp-action="Notes" asp-route-code="@Model.Code" method="post" data-autosave>
                    <label class="big-field select-arrow">
                        <span class="sr-only">Occasion</span>
                        <select name="Occasion">
                            <option value="">Select an occasion (optional)</option>
                            @foreach (var o in FormOptions.Occasions)
                            {
                                <option value="@o" selected="@(Model.Occasion == o)">@o</option>
                            }
                        </select>
                    </label>
                    <label class="big-field">
                        <span class="sr-only">Special request</span>
                        <textarea name="SpecialRequest" rows="7" maxlength="1000" placeholder="Add a special request">@Model.SpecialRequest</textarea>
                    </label>
                    <p class="autosave-status" data-autosave-status aria-live="polite"></p>
                </form>
            }
            else
            {
                <div></div>
            }
            <partial name="_RestaurantInfo" />
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/reservation.js" asp-append-version="true"></script>
}
