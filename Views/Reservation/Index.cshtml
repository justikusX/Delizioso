@model BookTableViewModel
@{
    ViewData["Title"] = "Book a table";
    ViewData["Nav"] = "Reservation";
    var culture = System.Globalization.CultureInfo.InvariantCulture;
    var today = DateOnly.FromDateTime(DateTime.Now);
}

<section class="booking">
    <div class="container booking-inner">
        <partial name="_BookingArt" />
        <div class="booking-form">
            <h1 class="title">@(Model.Modify != null ? "Change booking" : "Book a table")</h1>

            <form asp-action="Index" method="post" novalidate>
                <input type="hidden" asp-for="Modify" />
                <div asp-validation-summary="ModelOnly" class="auth-error"></div>

                <label class="select-field">
                    <span class="sr-only">Date</span>
                    <select asp-for="Date" required>
                        <option value="">Date</option>
                        @foreach (var d in ReservationRules.Dates(today))
                        {
                            <option value="@d.ToString("yyyy-MM-dd")" selected="@(Model.Date == d)">@(d == today ? "Today" : d == today.AddDays(1) ? "Tomorrow" : d.ToString("ddd, MMM d", culture))</option>
                        }
                    </select>
                    <span asp-validation-for="Date" class="field-error"></span>
                </label>

                <label class="select-field">
                    <span class="sr-only">Time</span>
                    <select asp-for="Time" required>
                        <option value="">Time</option>
                        @foreach (var t in ReservationRules.Slots)
                        {
                            <option value="@t.ToString("HH:mm")" selected="@(Model.Time == t)">@t.ToString("h:mm tt", culture)</option>
                        }
                    </select>
                    <span asp-validation-for="Time" class="field-error"></span>
                </label>

                <label class="select-field">
                    <span class="sr-only">Party size</span>
                    <select asp-for="Guests" required>
                        <option value="">Party size</option>
                        @for (var g = 1; g <= ReservationRules.MaxGuests; g++)
                        {
                            <option value="@g">@g @(g == 1 ? "person" : "people")</option>
                        }
                    </select>
                    <span asp-validation-for="Guests" class="field-error"></span>
                </label>

                <button class="booking-submit" type="submit">Book now</button>
            </form>
        </div>
    </div>
</section>
