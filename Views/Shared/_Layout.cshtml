@{
    var current = ViewData["Nav"] as string ?? "Home";
    string Active(string name) => name == current ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Delizioso</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&family=Raleway:wght@400;700&family=Tinos:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@ViewData["BodyClass"]">
    <header class="site-header">
        <div class="container header-inner">
            <a class="logo" href="/">
                <span class="logo-mark">D</span>
                <span class="logo-text">Delizi<span>oso</span></span>
            </a>

            <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false">
                <svg class="nav-icon-grid" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke-width="1.6" aria-hidden="true">
                    <rect x="1" y="1" width="8" height="8" rx="2.5" stroke="#311f09" /><rect x="13" y="1" width="8" height="8" rx="2.5" stroke="#311f09" />
                    <rect x="1" y="13" width="8" height="8" rx="2.5" stroke="#311f09" /><rect x="13" y="13" width="8" height="8" rx="4" stroke="#ff8a00" />
                </svg>
                <svg class="nav-icon-close" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#311f09" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M3 3l14 14M17 3L3 17" /></svg>
            </button>

            <nav class="main-nav">
                <a class="@Active("Home")" href="/">Home</a>
                <a class="@Active("Menu")" href="/Menu">Menu</a>
                <a class="@Active("About")" href="/About">About us</a>
                <a class="@Active("Order")" href="/Order">Order online</a>
                <a class="@Active("Reservation")" href="/Reservation">Reservation</a>
                <a class="@Active("Contact")" href="/Contact">Contact us</a>
                <div class="nav-account">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Account" asp-action="Index">My account</a>
                        <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit">Log out (@User.Identity.Name)</button></form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login">Log in</a>
                    }
                </div>
            </nav>

            <div class="header-actions">
                <a class="cart" href="/Order" aria-label="Cart">
                    <img src="~/img/cart.svg" alt="" width="24" height="24" />
                    <span class="cart-badge" data-cart-count>0</span>
                </a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="user-name" asp-controller="Account" asp-action="Index" title="My account">@User.Identity.Name</a>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="btn btn-green btn-sm" type="submit">Log out</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-green btn-sm" asp-controller="Account" asp-action="Login">Log in</a>
                }
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-grid">
            <div class="footer-about">
                <a class="logo logo-light" href="/">
                    <span class="logo-mark">D</span>
                    <span class="logo-text">Delizi<span>oso</span></span>
                </a>
                <p>Viverra gravida morbi egestas facilisis tortor netus non duis tempor.</p>
                <div class="socials">
                    <a href="#" aria-label="Twitter"><img src="~/img/twitter.png" alt="" /></a>
                    <a href="#" aria-label="Instagram"><img src="~/img/instagram.png" alt="" /></a>
                    <a href="#" aria-label="Facebook"><img src="~/img/facebook.png" alt="" /></a>
                </div>
            </div>
            <div class="footer-col">
                <h4>Page</h4>
                <a href="/">Home</a>
                <a href="/Menu">Menu</a>
                <a href="/Order">Order online</a>
                <a href="#">Catering</a>
                <a href="/Reservation">Reservation</a>
            </div>
            <div class="footer-col">
                <h4>Information</h4>
                <a href="/About">About us</a>
                <a href="/#testimonials">Testimonial</a>
                <a href="#">Event</a>
            </div>
            <div class="footer-col footer-contact">
                <h4>Get in touch</h4>
                <p>3247 Johnson Ave, Bronx, NY 10463, Amerika Serikat</p>
                <a href="mailto:delizioso@gmail.com">delizioso@gmail.com</a>
                <a href="tel:+12345678901">+123 4567 8901</a>
            </div>
        </div>
        <p class="copyright">Copyright &copy; @DateTime.Now.Year Delizioso</p>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
