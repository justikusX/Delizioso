@* Mini header shown inside the desktop "modal" cards (reservation and shipping pages). *@
<div class="modal-top">
    <a class="logo" href="/">
        <span class="logo-mark">D</span>
        <span class="logo-text">Delizi<span>oso</span></span>
    </a>
    <div class="modal-top-actions">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="user-name" asp-controller="Account" asp-action="Index">@User.Identity.Name</a>
        }
        else
        {
            <a class="btn btn-orange btn-pill" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">Sign in</a>
            <a class="btn btn-green btn-pill" asp-controller="Account" asp-action="Register" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">Sign up</a>
        }
    </div>
</div>
