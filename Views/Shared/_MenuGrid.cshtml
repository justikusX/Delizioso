@model MenuGridModel

<div class="menu-grid-block">
    <h2 class="title center">@Model.Title</h2>

    <div class="category-tabs" role="tablist">
        <button class="tab active" data-filter="all" type="button">All category</button>
        @foreach (var c in Model.Categories)
        {
            <button class="tab" data-filter="@c.Id" type="button">@c.Name</button>
        }
    </div>

    <div class="dish-grid" data-page-size="@Model.PageSize">
        @foreach (var d in Model.Dishes)
        {
            <article class="dish-card" data-category="@d.CategoryId">
                <img class="dish-img" src="@d.ImageUrl" alt="@d.Name" loading="lazy" />
                <h3>@d.Name</h3>
                <div class="stars" aria-label="@d.Rating out of 5">
                    @for (var i = 1; i <= 5; i++)
                    {
                        <span class="@(i <= d.Rating ? "on" : "")">&#9733;</span>
                    }
                </div>
                <p>@d.Description</p>
                <div class="dish-footer">
                    <span class="price">$@d.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</span>
                    <button class="btn btn-orange btn-md" type="button" data-add-to-cart="@d.Id">Order now</button>
                </div>
            </article>
        }
    </div>
    <p class="empty-note" hidden>No dishes in this category yet.</p>

    <nav class="pager" aria-label="Pages">
        <button class="pager-arrow prev" type="button" aria-label="Previous"><img src="~/img/arrow-left.svg" alt="" /></button>
        <span class="pager-nums"></span>
        <button class="pager-arrow next" type="button" aria-label="Next"><img src="~/img/arrow-right.svg" alt="" /></button>
    </nav>
</div>
