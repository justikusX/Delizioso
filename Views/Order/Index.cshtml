@model OrderPageViewModel
@{
    ViewData["Title"] = "Order online";
    ViewData["Nav"] = "Order";
    var culture = System.Globalization.CultureInfo.InvariantCulture;
}

<section class="order-page">
    <div class="container">
        <h1 class="title center">Menu</h1>

        <div class="category-tabs order-tabs" role="tablist">
            <button class="tab active" data-filter="all" type="button">All category</button>
            @foreach (var c in Model.Categories)
            {
                <button class="tab" data-filter="@c.Id" type="button">@c.Name</button>
            }
        </div>

        <div class="order-layout">
            <div class="order-sections">
                @foreach (var group in OrderRules.Groups)
                {
                    var dishes = Model.Dishes.Where(d => d.Group == group).ToList();
                    if (dishes.Count == 0) { continue; }
                    <section class="order-group" data-order-group>
                        <h2 class="group-title">@group</h2>
                        <div class="order-grid" data-page-size="9">
                            @foreach (var d in dishes)
                            {
                                <article class="order-card" data-dish="@d.Id" data-category="@d.CategoryId">
                                    <img src="@d.ImageUrl" alt="@d.Name" loading="lazy" />
                                    <h3>@d.Name</h3>
                                    <div class="stars small" aria-label="@d.Rating out of 5">
                                        @for (var i = 1; i <= 5; i++) { <span class="@(i <= d.Rating ? "on" : "")">&#9733;</span> }
                                    </div>
                                    <p>@d.Description</p>
                                    <div class="order-card-footer">
                                        <span class="price">$@d.Price.ToString("0.00", culture)</span>
                                        <button class="order-add" type="button" data-add-to-cart="@d.Id" aria-label="Add @d.Name to the order">
                                            <span class="lbl">Order now</span><span class="plus" aria-hidden="true">+</span><span class="qty" data-qty></span>
                                        </button>
                                    </div>
                                </article>
                            }
                        </div>
                        <nav class="pager" aria-label="@group pages">
                            <button class="pager-arrow prev" type="button" aria-label="Previous"><img src="~/img/arrow-left.svg" alt="" /></button>
                            <span class="pager-nums"></span>
                            <button class="pager-arrow next" type="button" aria-label="Next"><img src="~/img/arrow-right.svg" alt="" /></button>
                        </nav>
                    </section>
                }
                <p class="empty-note" data-order-empty hidden>No dishes in this category yet.</p>
            </div>

            <aside class="order-aside">
                <div class="order-list" data-order-list></div>
            </aside>
        </div>
    </div>

    <div class="order-bar" data-order-bar>
        <div>
            <span data-bar-items>0 Items</span>
            <b data-bar-total>$0.00</b>
        </div>
        <a class="order-bar-btn" asp-action="List">Order now</a>
    </div>
</section>

<partial name="_DishData" model="Model.Dishes" />
@section Scripts {
    <script src="~/js/order.js" asp-append-version="true"></script>
}
