@model Order
@{
    ViewData["Title"] = "Order placed";
    ViewData["Nav"] = "Order";
    var culture = System.Globalization.CultureInfo.InvariantCulture;
    string Money(decimal d) => "$" + d.ToString("0.00", culture);
    var payment = OrderRules.Payments.FirstOrDefault(p => p.Value == Model.Payment).Label;
    var method = OrderRules.Methods.FirstOrDefault(m => m.Value == Model.Method).Label;
}

<section class="checkout placed" data-clear-cart>
    <div class="container checkout-inner">
        <div class="status-banner green placed-banner">
            <span class="bubble b1"></span><span class="bubble b2"></span><span class="bubble b3"></span><span class="bubble b4"></span>
            <h1>Thank you, your order has been placed</h1>
            <p><partial name="_Icons" model='"ticket"' /> Order ID : #@Model.Code</p>
            <p><partial name="_Icons" model='"clock"' /> @(Model.ScheduledFor is { } at ? "Scheduled for " + at.ToString("dddd h:mm tt", culture) : "We're preparing it now")</p>
        </div>

        <div class="placed-grid">
            <div>
                <h2 class="co-h">Your order</h2>
                <ul class="placed-items">
                    @foreach (var i in Model.Items)
                    {
                        <li><img src="@i.Dish!.ImageUrl" alt="" /><span>@i.Dish.Name &times; @i.Quantity</span><b>@Money(i.UnitPrice * i.Quantity)</b></li>
                    }
                </ul>
                <dl class="order-sums">
                    <div><dt>Subtotal</dt><dd>@Money(Model.Subtotal)</dd></div>
                    <div><dt>Tax fee</dt><dd>@Money(Model.Tax)</dd></div>
                    <div><dt>Voucher @(Model.VoucherCode != "" ? $"({Model.VoucherCode})" : "")</dt><dd>@(Model.Discount > 0 ? "−" + Money(Model.Discount) : Money(0))</dd></div>
                    <div class="total"><dt>Total</dt><dd>@Money(Model.Total)</dd></div>
                </dl>
            </div>
            <div class="res-card">
                <h2 class="res-h">Order detail</h2>
                <dl class="placed-detail">
                    <div><dt>Name</dt><dd>@Model.CustomerName</dd></div>
                    <div><dt>Phone</dt><dd>@Model.Phone</dd></div>
                    <div><dt>Order method</dt><dd>@method</dd></div>
                    @if (Model.Method == "Delivery")
                    {
                        <div><dt>Address</dt><dd>@Model.Address</dd></div>
                    }
                    <div><dt>Payment</dt><dd>@payment</dd></div>
                    @if (Model.Note != "")
                    {
                        <div><dt>Note</dt><dd>@Model.Note</dd></div>
                    }
                </dl>
                @if (Model.Payment != "Cash")
                {
                    <p class="co-hint">Our staff will contact you at @Model.Phone with the payment details.</p>
                }
            </div>
        </div>
        <div class="center"><a class="btn btn-orange" asp-action="Index">Back to menu</a></div>
    </div>
</section>

@section Scripts {
    <script>
        // The order is saved on the server, so the browser cart and voucher can be emptied.
        try { localStorage.removeItem('delizioso-voucher'); } catch { }
        window.cart.clear();
    </script>
}
