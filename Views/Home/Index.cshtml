@model HomeViewModel
@{
    ViewData["Title"] = "Italian Cuisine";
    ViewData["Nav"] = "Home";
    var featured = Model.Testimonials.FirstOrDefault(t => t.AuthorName == "Starla Virgoun") ?? Model.Testimonials.FirstOrDefault();
}

<!-- Hero -->
<section class="hero">
    <div class="container hero-inner">
        <div class="hero-text">
            <span class="pill">Restaurant</span>
            <h1>Italian Cuisine</h1>
            <p class="lead">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sodales senectus dictum arcu sit tristique donec eget.</p>
            <div class="btn-row">
                <a class="btn btn-orange" href="/Order">Order now</a>
                <a class="btn btn-green" href="/Reservation">Reservation</a>
            </div>
        </div>
        <div class="hero-art">
            <img class="leaf leaf-top" src="~/img/lettuce.png" alt="" />
            <img class="plate" src="~/img/hero-plate.png" alt="Spaghetti bolognese" />
            <img class="leaf leaf-bottom" src="~/img/lettuce.png" alt="" />
        </div>
    </div>
</section>

<!-- Welcome -->
<section class="welcome">
    <div class="container split">
        <div class="split-art">
            <img src="~/img/welcome-salad.png" alt="Fresh salad" />
        </div>
        <div class="split-text">
            <h2 class="title">Welcome to <span>delizioso</span></h2>
            <p class="lead">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Facilisis ultricies at eleifend proin. Congue nibh nulla malesuada ultricies nec quam</p>
            <a class="btn btn-orange" href="/Menu">See our menu</a>
        </div>
    </div>
</section>

<!-- Popular menu -->
<section class="popular" id="menu">
    <div class="container">
        <partial name="_MenuGrid" model="@(new MenuGridModel { Title = "Our popular menu", Categories = Model.Categories, Dishes = Model.PopularDishes })" />
    </div>
</section>

<!-- Reserve a table -->
<section class="reserve">
    <div class="container split">
        <div class="split-art reserve-art">
            <div class="orbit"></div>
            <div class="reserve-main"><img src="~/img/reserve-main.png" alt="Friends sharing food" /></div>
            <div class="reserve-small s1"><img src="~/img/reserve-small1.png" alt="" /></div>
            <div class="reserve-small s2"><img src="~/img/reserve-small2.png" alt="" /></div>
        </div>
        <div class="split-text">
            <h2 class="title">Let's reserve <span>a table</span></h2>
            <p class="lead">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Facilisis ultricies at eleifend proin. Congue nibh nulla malesuada ultricies nec quam</p>
            <a class="btn btn-orange" href="/Reservation">Reservation</a>
        </div>
    </div>
</section>

<!-- Chefs -->
<section class="chefs">
    <div class="container">
        <h2 class="title center">Our greatest chef</h2>
        <div class="chef-grid">
            @foreach (var c in Model.Chefs)
            {
                <article class="chef-card">
                    <div class="chef-photo" style="background:@c.CardColor">
                        <img src="@c.PhotoUrl" alt="@c.Name" loading="lazy" />
                    </div>
                    <h3>@c.Name</h3>
                    <p>@c.Position</p>
                </article>
            }
        </div>
        <div class="center"><a class="btn btn-orange" href="/About">View all</a></div>
    </div>
</section>

<!-- Testimonials -->
<section class="testimonials" id="testimonials">
    <img class="bubbles" src="~/img/customers-bg.svg" alt="" />
    <div class="container">
        <h2 class="title center">Our customers say</h2>
        @if (featured != null)
        {
            <div class="review">
                <img class="review-photo" src="@featured.PhotoUrl" alt="" data-review-photo />
                <h3 data-review-name>@featured.AuthorName</h3>
                <p class="review-role" data-review-role>@featured.AuthorPosition</p>
                <blockquote data-review-text>@featured.Text</blockquote>
            </div>
            <div class="avatars">
                @foreach (var t in Model.Testimonials)
                {
                    <button type="button" class="avatar @(t.Id == featured.Id ? "active" : "")"
                            data-name="@t.AuthorName" data-role="@t.AuthorPosition" data-text="@t.Text" data-photo="@t.PhotoUrl"
                            aria-label="Review by @t.AuthorName">
                        <img src="@t.PhotoUrl" alt="" loading="lazy" />
                    </button>
                }
            </div>
        }
    </div>
</section>

<!-- Opening hours -->
<section class="open-hours">
    <div class="container">
        <div class="open-card">
            <h2 class="title">we are open from</h2>
            <p class="days">Monday-Sunday</p>
            <p>Launch : Mon-Sun : 11:00am-02:00pm</p>
            <p>Dinner : sunday : 04:00pm-08:00pm</p>
            <p class="indent">04:00pm-09:00pm</p>
            <div class="btn-row">
                <a class="btn btn-orange" href="/Order">Order now</a>
                <a class="btn btn-white" href="/Reservation">Reservation</a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/menu-grid.js" asp-append-version="true"></script>
    <script src="~/js/home.js" asp-append-version="true"></script>
}
